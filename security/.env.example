# Copy to `.env` and fill with real values. `.env` MUST be gitignored.
# This file (`.env.example`) contains placeholder values only.

# --- Web tier ---
APP_PORT=8080

# --- Database ---
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGE_ME_long_random_string
POSTGRES_DB=appdb

# --- Cache ---
REDIS_PASSWORD=CHANGE_ME_another_long_random_string

# --- Secrets (referenced by docker secrets) ---
# Populate ./secrets/database_url.txt and ./secrets/jwt_secret.txt at deploy time.
