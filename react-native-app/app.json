{
  "expo": {
    "name": "Faazio",
    "slug": "faazio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.faazio.customer",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access to upload medical prescriptions and scan bar codes.",
        "NSPhotoLibraryUsageDescription": "This app requires photo library access to upload medical prescriptions and profile photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.faazio.customer",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Faazio to access your photos to save invoices and upload prescriptions."
        }
      ]
    ]
  }
}
