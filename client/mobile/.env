# Faazio mobile app — environment. SINGLE SOURCE OF TRUTH (tracked).
# `scripts/configure.js` generates src/lib/config.ts from these values at prestart/preandroid;
# release CI (.github/workflows/release-apk.yml, ios-release.yml) passes the same values as
# GitHub secrets. The app is server-only: `@data/*` fixtures are never substituted at runtime.
# Set GATEWAY_URL; without it every GatewayClient call throws GatewayOfflineError.
#
# No real secrets belong here (client config only). A local `.env.local` (gitignored) still
# overrides these values for one machine and is read after `.env`.

# Product root bundled by index.js. `customer` = the SuperApp; `delivery` = the standalone
# Delivery Partner app; `seller` = the Seller Partner app (restaurants, mart, pharma). Select the
# matching Android product flavor / iOS configuration. Generated into src/lib/appVariant.ts
# (gitignored); run `APP_VARIANT=delivery|seller npm run configure` before a partner build.
APP_VARIANT=customer

# Go Chi gateway base URL, no trailing slash. Production goes through Cloudflare:
# https://api.faazio.com (local: http://localhost:8080)
GATEWAY_URL=https://api.faazio.com

# Web Partner Portal origin for the seller WebView shell (no trailing slash). The portal owns the
# seller session via HttpOnly cookies; the seller app has no native auth. A seller build (dev or
# release) fails configure when this is empty. e.g. https://app.faazio.com or http://localhost:3000.
WEB_PORTAL_URL=https://app.faazio.com

# Flip the app to REMOTE mode. Required together with GATEWAY_URL; without it every GatewayClient
# call throws GatewayOfflineError (no @data/* fixture fallback).
USE_GATEWAY=true

# Strict writes: money/Rx/address WRITES never silently fall back to a local mock — a failed
# remote write surfaces as an error instead of a fake local success. Keep true for staging/prod.
STRICT=true

# Dev-only identity override for an AUTH_DISABLED=true gateway (local/pre-prod staging). Sent as the
# `X-Dev-User` header **only in dev builds**; never attached in a release build. Leave empty for
# production (Firebase sessions are used instead).
DEV_USER=

# Firebase Phone Auth (native SDK). `true` (default) wires the send/verify flow; the native
# `android/app/google-services.json` + `ios/Faazio/GoogleService-Info.plist` carry the public
# client config (no secret env needed). Release builds with USE_GATEWAY=true fail if either file
# is missing, so a mock-login build can never ship.
USE_FIREBASE_AUTH=true

# Comma-separated base64 SHA-256 SPKI pins for the gateway host. Required for release builds
# when USE_GATEWAY=true (see scripts/configure.js / docs/RUNBOOKS/RELEASE.md).
# Regenerate after any edge-cert rotation: scripts/cert-pins.sh (leaf + intermediate).
CERT_PINS=6mUBFN2KO9S5gSZVAl0Y7NMJO3qQdjho9sU1fLFnSpg=,kIdp6NNEd8wsugYyyIYFsi1ylMCED3hZbSR8ZFsa/A4=

# Google Maps SDK for Android (restricted to the app package + SHA-1; NOT a secret but keep out of
# git). scripts/configure.js writes android/app/src/main/res/values/google_maps_api_key.xml.
# Empty => the seller shop-pin map renders blank; onboarding still works.
GOOGLE_MAPS_API_KEY_ANDROID=AIzaSyDrfxMIhLZynmGLCGNSDZa_yeplAc2kx04
# iOS Maps SDK key. Not required when using the default Apple provider.
GOOGLE_MAPS_API_KEY_IOS=AIzaSyCPf0dHcK1QBapJA6HrYNFR4kLy72La9Oo

# Google Places API (New), used by the Location screen autocomplete. Restrict it to the Places API
# (and the app bundle/package). Empty => the screen falls back to the static suggestion list.
GOOGLE_PLACES_API_KEY=AIzaSyAS9q64rGgwZCHobxLFDDDo6joIDUe1JdE

# ─────────────────────────────────────────────────────────────────────────────
# iOS App Store CI release — create these as GitHub secrets/variables, then run
# `.github/workflows/ios-release.yml`. They are NOT read by scripts/configure.js
# (the workflow injects them). Fill the placeholders once, then:
#   gh secret set <NAME>   (for the blobs/keys)   |   gh variable set <NAME> (for IDs)
# Never commit the real signing material.
#
# Shared Apple Distribution certificate (signs all three products):
# APPSTORE_CERTIFICATE_BASE64=          # base64 -i distribution.p12
# APPSTORE_CERTIFICATE_PASSWORD=
# APPSTORE_TEAM_ID=                     # 10-char Apple Developer Team ID
#
# Per-product App Store provisioning profiles (base64 -i *.mobileprovision):
# APPSTORE_PROVISIONING_PROFILE_CUSTOMER=
# APPSTORE_PROVISIONING_PROFILE_DELIVERY=
# APPSTORE_PROVISIONING_PROFILE_SELLER=
#
# App Store Connect API key (Users and Access → Integrations → App Store Connect API):
# APPSTORE_ISSUER_ID=
# APPSTORE_API_KEY_ID=
# APPSTORE_API_PRIVATE_KEY=             # contents of AuthKey_XXXXXXXXXX.p8
#
# Firebase iOS plists for the partner apps (base64 -i GoogleService-Info-*.plist):
# GOOGLE_SERVICE_INFO_DELIVERY_PLIST=
# GOOGLE_SERVICE_INFO_SELLER_PLIST=
# ─────────────────────────────────────────────────────────────────────────────
