# Faazio mobile app — ANDROID environment (committed, complete/standalone).
#
# Loaded by scripts/configure.js when CONFIGURE_PLATFORM=android. For a platform-agnostic
# run (Metro / ts:check) both .env.android and .env.ios are loaded. A gitignored .env.local
# overrides this file, and process env (CI secrets) wins over everything.
#
# This file is deliberately complete: it carries its own copy of the shared values (they are
# duplicated in .env.ios on purpose) so each platform can be read and filled independently.

# — Shared build config —
APP_VARIANT=customer
GATEWAY_URL=https://api.faazio.com
WEB_PORTAL_URL=https://app.faazio.com
USE_GATEWAY=true
STRICT=true
DEV_USER=
USE_FIREBASE_AUTH=true

# Comma-separated base64 SHA-256 SPKI pins for the gateway host. Required for release builds
# when USE_GATEWAY=true. Regenerate after any edge-cert rotation: scripts/cert-pins.sh.
CERT_PINS=6mUBFN2KO9S5gSZVAl0Y7NMJO3qQdjho9sU1fLFnSpg=,kIdp6NNEd8wsugYyyIYFsi1ylMCED3hZbSR8ZFsa/A4=

# — Google keys (Android) —
# Places API (New), used by the Location screen autocomplete. Consumed from src/lib/config.ts.
GOOGLE_PLACES_API_KEY=AIzaSyAS9q64rGgwZCHobxLFDDDo6joIDUe1JdE
# Maps SDK for Android. configure.js writes android/app/src/main/res/values/google_maps_api_key.xml.
# Restrict it to the app packages + release SHA-1 in Google Cloud. Empty => blank shop-pin map.
GOOGLE_MAPS_API_KEY_ANDROID=AIzaSyDrfxMIhLZynmGLCGNSDZa_yeplAc2kx04

# — Android release credentials (GitHub Actions secrets) —
# NOT read by scripts/configure.js. Set the real values on the repo (never in this committed
# file):  gh secret set <NAME>   (per-product suffix _CUSTOMER / _DELIVERY / _SELLER).
# Listed here only so the full credential set is visible in one place.
KEYSTORE_BASE64_CUSTOMER=
KEYSTORE_PASS_CUSTOMER=
KEY_ALIAS_CUSTOMER=
ALIAS_PASS_CUSTOMER=
KEYSTORE_BASE64_DELIVERY=
KEYSTORE_PASS_DELIVERY=
KEY_ALIAS_DELIVERY=
ALIAS_PASS_DELIVERY=
KEYSTORE_BASE64_SELLER=
KEYSTORE_PASS_SELLER=
KEY_ALIAS_SELLER=
ALIAS_PASS_SELLER=
# Partner Firebase native configs (base64 of google-services.json). The customer file is committed.
GOOGLE_SERVICES_DELIVERY_JSON=
GOOGLE_SERVICES_SELLER_JSON=
