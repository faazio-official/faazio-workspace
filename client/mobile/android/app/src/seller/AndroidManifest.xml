<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
  <!-- Seller-only: route FCM notification payloads through the high-importance order channel
       created in MainApplication (custom beep). Customer/delivery builds never merge this. -->
  <application
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round">
    <meta-data
      android:name="com.google.firebase.messaging.default_notification_channel_id"
      android:value="seller_orders"
      tools:replace="android:value"/>
    <!-- The seller product is a WebView shell over the portal and never mounts a MapView, so it
         must not carry the Maps SDK key. Strip the meta-data merged from src/main (the shared shell
         still builds react-native-maps for the customer/delivery flavors — do NOT remove the dep). -->
    <meta-data
      android:name="com.google.android.geo.API_KEY"
      tools:node="remove"/>
  </application>
</manifest>
