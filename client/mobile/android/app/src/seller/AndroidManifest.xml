<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
  <!-- The seller product is a WebView shell and never places calls. react-native-callkeep's
       library manifest merges phone permissions into every flavor, so strip them here to keep the
       seller permission surface honest (Play data-safety + least privilege). -->
  <uses-permission android:name="android.permission.CALL_PHONE" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" tools:node="remove"/>
  <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" tools:node="remove"/>
  <!-- Seller-only: route FCM notification payloads through the high-importance order channel
       created in MainApplication (custom beep). Customer/delivery builds never merge this. -->
  <application
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round">
    <meta-data
      android:name="com.google.firebase.messaging.default_notification_channel_id"
      android:value="seller_orders"
      tools:replace="android:value"/>
    <!-- The seller product is a WebView shell over the portal and never mounts a MapView, so it
         must not carry the Maps SDK key. Strip the meta-data merged from src/main (the shared shell
         still builds react-native-maps for the customer/delivery flavors — do NOT remove the dep). -->
    <meta-data
      android:name="com.google.android.geo.API_KEY"
      tools:node="remove"/>
  </application>
</manifest>
