<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Delivery-partner-only background tracking. Customer builds never merge this manifest. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
  <uses-permission android:name="android.permission.WAKE_LOCK"/>

  <!-- Masked delivery calling (100ms voice + CallKeep/system ringing). Delivery flavor only. -->
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL"/>
  <uses-permission android:name="android.permission.MANAGE_OWN_CALLS"/>
  <uses-permission android:name="android.permission.READ_PHONE_STATE" android:maxSdkVersion="29"/>

  <application
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round">
    <!-- Warm/cold-start offer deep link from the system notification. -->
    <activity android:name=".MainActivity">
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="faazio-delivery" android:host="accept-reject"/>
      </intent-filter>
    </activity>
    <service
      android:name=".DeliveryTrackingService"
      android:exported="false"
      android:foregroundServiceType="location"
      android:stopWithTask="false"/>
    <service
      android:name=".DeliveryHeartbeatTaskService"
      android:exported="false"/>
    <!-- Native incoming-call UI (ConnectionService). Required by react-native-callkeep. -->
    <service
      android:name="io.wazo.callkeep.VoiceConnectionService"
      android:label="Faazio Delivery Calls"
      android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
      android:foregroundServiceType="phoneCall"
      android:exported="true">
      <intent-filter>
        <action android:name="android.telecom.ConnectionService"/>
      </intent-filter>
    </service>
  </application>
</manifest>
