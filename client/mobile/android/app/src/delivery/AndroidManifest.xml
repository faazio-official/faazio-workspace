<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
  <!-- Delivery-partner-only background tracking. Customer builds never merge this manifest. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
  <uses-permission android:name="android.permission.WAKE_LOCK"/>

  <!-- Masked delivery calling: 100ms VOIP audio + a full-screen-intent ring notification. Ringing
       deliberately does not use the telecom ConnectionService, so no phone account is registered and
       the rider never sees the "Phone account required" dialog. Delivery flavor only. -->
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
  <!-- Android 11 and below expose paired-audio discovery through the legacy Bluetooth permission. -->
  <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
  <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
  <!-- Incoming call wakes the lock screen (Android 14+ may require the user to grant the special
       "full-screen notifications" access; a denial degrades to a heads-up notification). -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>

  <!-- react-native-callkeep stays a dependency for a possible future opt-in, but this product never
       registers a phone account. Strip the phone-account permissions its library manifest merges in
       so the install-time permission set stays honest (Play data safety + least privilege). -->
  <uses-permission android:name="android.permission.CALL_PHONE" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" tools:node="remove"/>
  <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" tools:node="remove"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" tools:node="remove"/>

  <application
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round">
    <!-- Warm/cold-start offer deep link from the system notification. -->
    <activity android:name=".MainActivity">
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="faazio-delivery" android:host="accept-reject"/>
      </intent-filter>
    </activity>
    <service
      android:name=".DeliveryTrackingService"
      android:exported="false"
      android:foregroundServiceType="location"
      android:stopWithTask="false"/>
    <service
      android:name=".DeliveryHeartbeatTaskService"
      android:exported="false"/>
    <!-- Answer / Decline actions on the ringing notification. -->
    <receiver
      android:name=".IncomingCallReceiver"
      android:exported="false"/>
    <!-- Holds the microphone grant while a VOIP call is connected (Android 14+ requires a typed
         foreground service for background microphone access). -->
    <service
      android:name=".CallAudioService"
      android:exported="false"
      android:foregroundServiceType="microphone"
      android:stopWithTask="false"/>
  </application>
</manifest>
