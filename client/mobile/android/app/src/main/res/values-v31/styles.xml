<resources xmlns:tools="http://schemas.android.com/tools">
  <!-- API 31+ splash is drawn by the system: icon + background only.
       The "Product of FA CREATORS" credit is intentionally NOT drawn here via
       windowSplashScreenBrandingImage: the platform stretches that bitmap to fill
       a WindowManager-Shell-sized view (starting_surface_brand_image_width/
       height) whose aspect ratio is OS/OEM-dependent, which distorted the text
       (squeezed horizontally, stretched vertically) on real devices. The credit
       is owned by the JS layer-2 `SplashFallback`, which draws it as real text
       and can never distort. -->
  <style name="Theme.App.SplashScreen" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/splashscreen_background</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/splashscreen_logo</item>
    <item name="postSplashScreenTheme">@style/AppTheme</item>
    <item name="android:windowSplashScreenBehavior">icon_preferred</item>
  </style>
</resources>
