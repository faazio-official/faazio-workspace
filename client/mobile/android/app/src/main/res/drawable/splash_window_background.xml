<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash window background for API 24-30 (pre-Android 12).

  The launch screen is the theme's `android:windowBackground` (a drawable, not a
  view), so it can only render the background + the centred wordmark. The
  "Product of FA CREATORS" credit is intentionally NOT composited here: the JS
  layer-2 `SplashFallback` draws it as real text, which cannot be stretched or
  distorted the way a baked bitmap can.

  The logo item reproduces the platform's own 288dp centred icon so pre-31
  matches the API 31+ splash instead of drifting.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="fill">
        <color android:color="@color/splashscreen_background" />
    </item>
    <item
        android:drawable="@drawable/splashscreen_logo"
        android:gravity="center"
        android:width="288dp"
        android:height="288dp" />
</layer-list>
