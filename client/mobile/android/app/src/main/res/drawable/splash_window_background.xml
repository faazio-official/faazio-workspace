<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash window background for API 24-30 (pre-Android 12).

  On these versions androidx core-splashscreen draws the launch screen as the
  theme's `android:windowBackground` (a drawable, not a view), so text cannot be
  rendered. The "Product of FA CREATORS" credit is therefore baked to
  `splashscreen_tagline.png` by scripts/generate-splash-logo.py and composited
  here at the bottom, centred.

  The logo item reproduces the platform's own 288dp centred icon so pre-31
  matches the API 31+ splash instead of drifting.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="fill">
        <color android:color="@color/splashscreen_background" />
    </item>
    <item
        android:drawable="@drawable/splashscreen_logo"
        android:gravity="center"
        android:width="288dp"
        android:height="288dp" />
    <item
        android:drawable="@drawable/splashscreen_tagline"
        android:gravity="center_horizontal|bottom"
        android:bottom="@dimen/splashscreen_tagline_margin_bottom" />
</layer-list>
