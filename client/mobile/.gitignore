
# vim
*.swp

# Generated JS/config (scripts/configure.js) — never commit.
/src/lib/config.ts
/src/lib/activeTransport.ts
/src/lib/appVariant.ts
/src/lib/config.js
/src/lib/activeTransport.js
/src/lib/appVariant.js

# Committed bare-RN native projects are the source of truth (no prebuild).
# Only build outputs / installable APKs / local secrets are ignored.
*.apk
*.aab
/build/

# Release signing secrets
/keystore/
*.keystore
!android/app/debug.keystore
keystore*.properties
*.der
*.p12
*.jks

# Environment: `.env.android.{customer,delivery,seller}` and `.env.ios` are the
# tracked per-app/per-platform build config (each complete/standalone).
# Local-only overrides stay gitignored.
.env.local
.env.*.local
# Generated by scripts/configure.js (restricted Maps key).
/android/app/src/main/res/values/google_maps_api_key.xml
