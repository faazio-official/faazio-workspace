{
  "name": "faazio",
  "version": "1.0.5",
  "main": "index.js",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Faizal Basha S <faizalbashafaizalbasha07@gmail.com>",
  "scripts": {
    "configure": "node scripts/configure.js",
    "configure:delivery": "APP_VARIANT=delivery node scripts/configure.js",
    "configure:seller": "APP_VARIANT=seller node scripts/configure.js",
    "prestart": "node scripts/configure.js",
    "start": "react-native start",
    "start:delivery": "APP_VARIANT=delivery node scripts/configure.js && react-native start",
    "start:seller": "APP_VARIANT=seller node scripts/configure.js && react-native start",
    "preandroid": "node scripts/configure.js",
    "android": "react-native run-android",
    "preios": "node scripts/configure.js",
    "ios": "react-native run-ios",
    "ts:check": "node scripts/configure.js && tsc",
    "check:boundaries": "node scripts/configure.js && depcruise src --config .dependency-cruiser.cjs",
    "check:drillin": "node scripts/check-drillin-coverage.mjs",
    "bundle:android": "node scripts/configure.js && react-native bundle --platform android --dev false --entry-file index.js --bundle-output /tmp/faazio-index.android.bundle --assets-dest /tmp/faazio-assets",
    "bundle:delivery": "APP_VARIANT=delivery node scripts/configure.js && react-native bundle --platform android --dev false --entry-file index.delivery.js --bundle-output /tmp/faazio-delivery.android.bundle --assets-dest /tmp/faazio-delivery-assets",
    "bundle:seller": "APP_VARIANT=seller node scripts/configure.js && react-native bundle --platform android --dev false --entry-file index.seller.js --bundle-output /tmp/faazio-seller.android.bundle --assets-dest /tmp/faazio-seller-assets",
    "postinstall": "patch-package && node scripts/configure.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-firebase/app": "27.0.0",
    "@react-native-firebase/auth": "27.0.0",
    "@react-native-firebase/messaging": "27.0.0",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@shopify/flash-list": "2.0.2",
    "lucide-react-native": "^1.27.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keychain": "^10.0.0",
    "react-native-maps": "^1.29.11",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sound": "^0.13.0",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "^4.7.3",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.10.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "dependency-cruiser": "^18.1.1",
    "patch-package": "^8.0.1",
    "react-native-svg-transformer": "^1.5.3",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "private": true
}
