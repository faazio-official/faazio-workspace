# Faazio mobile app — environment (copy to .env.local; never commit secrets).
# `scripts/configure.js` generates src/lib/config.ts from these values at prestart/preandroid.
# With GATEWAY_URL/USE_GATEWAY unset the app runs in MOCK mode against @data/* fixtures.

# Go Chi gateway base URL, no trailing slash. e.g. https://faazio-workspace.onrender.com or
# http://localhost:8080
GATEWAY_URL=

# Flip the app to REMOTE mode. Required together with GATEWAY_URL; when either is
# missing every GatewayClient method resolves to the @data/* mock.
USE_GATEWAY=false

# Strict writes: money/Rx/address WRITES never silently fall back to a local mock — a failed
# remote write surfaces as an error instead of a fake local success. Keep true for staging/prod.
STRICT=true

# Dev-only identity override for an AUTH_DISABLED=true gateway (local/MVP staging). Sent as the
# `X-Dev-User` header **only in dev builds**; never attached in a release build. Leave empty for
# production (Firebase sessions are used instead).
DEV_USER=

# Firebase Phone Auth (native SDK). Defaults to `true`; set `false` only for a local mock-login
# run. The public client config lives in `android/app/google-services.json` and
# `ios/Faazio/GoogleService-Info.plist` — no secret env vars are needed. Release builds with
# USE_GATEWAY=true fail if either native file is missing.
USE_FIREBASE_AUTH=true

# Comma-separated base64 SHA-256 SPKI pins for the gateway host. Required for release builds
# when USE_GATEWAY=true (see scripts/configure.js / docs/RUNBOOKS/RELEASE.md).
CERT_PINS=
