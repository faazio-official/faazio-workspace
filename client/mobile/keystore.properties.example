# Template for the gitignored release signing file.
#
# Copy to the keystore directory and fill in the real values:
#   cp keystore.properties.example keystore/keystore.properties && chmod 600 keystore/keystore.properties
#
# `android/app/build.gradle` reads `keystore/keystore.properties` (gitignored, never committed).
# CI reconstructs it from GitHub secrets via scripts/restore-keystore.sh, so only a local release
# build needs this file. Key names are fixed — do not rename them.
#
# STORE_FILE is relative to android/app/ (the Gradle project dir).
STORE_FILE=../../keystore/faazio-release.keystore
KEYSTORE_PASS=<keystore password>
KEY_ALIAS=<key alias, e.g. faazio>
ALIAS_PASS=<alias password>
