{
  "expo": {
    "name": "Faazio",
    "slug": "faazio",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/faazio-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#7C3AED"
    },
    "icon": "./src/assets/icon.png",
    "assetBundlePatterns": [
      "src/assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.faazio.customer",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access to upload medical prescriptions and scan bar codes.",
        "NSPhotoLibraryUsageDescription": "This app requires photo library access to upload medical prescriptions and profile photos."
      }
    },
    "android": {
      "package": "com.faazio.customer",
      "jsEngine": "hermes",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#7C3AED"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7C3AED",
          "image": "./src/assets/faazio-logo.png",
          "imageWidth": 200
        }
      ]
    ]
  }
}
