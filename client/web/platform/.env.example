# Faazio Partner Portal — environment (copy to .env.local; never commit secrets).
# With these unset the portal runs in local seed mode (localStorage demo data).

# Go Chi gateway base URL (no trailing slash). e.g. http://localhost:8080
NEXT_PUBLIC_GATEWAY_URL=

# Auth mode: "mock" (default) signs in against the built-in demo directory even
# when Supabase creds are set. Set to "supabase" to use GoTrue for login.
NEXT_PUBLIC_AUTH_MODE=mock

# Dev-only identity override, sent as X-Dev-{Role,Seller,State}. Only honored by a gateway running
# with AUTH_DISABLED=true (local / MVP staging); never sent in production builds. Lets the mocked
# portal exercise role-gated writes, e.g. NEXT_PUBLIC_DEV_ROLE=SUPER_ADMIN.
NEXT_PUBLIC_DEV_ROLE=
NEXT_PUBLIC_DEV_SELLER=
NEXT_PUBLIC_DEV_STATE=

# Supabase project (Storage; used for Auth only when NEXT_PUBLIC_AUTH_MODE=supabase).
# The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=