# Partner Portal environment — copy to .env.local (never commit it).
# Every value here is public build-time config; secrets live on the gateway.

# Gateway origin. In portal auth mode the Next.js route handlers call this server-side.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# "mock" (default demo directory) | "supabase" (GoTrue) | "portal" (gateway-native superadmin)
NEXT_PUBLIC_AUTH_MODE=mock

# Mock/supabase demo overrides (leave empty for the seeded SUPER_ADMIN).
NEXT_PUBLIC_DEV_ROLE=
NEXT_PUBLIC_DEV_SELLER=
NEXT_PUBLIC_DEV_STATE=

# Only needed for NEXT_PUBLIC_AUTH_MODE=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional media CDN/asset base (defaults to the gateway's /assets path).
NEXT_PUBLIC_MEDIA_CDN_BASE=

# Portal mode only needs the gateway to have PORTAL_JWT_SECRET + PORTAL_PEPPER and
# migration 0032 applied. See docs/RUNBOOKS/PORTAL_AUTH.md.
