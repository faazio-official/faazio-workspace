# Partner Portal environment — copy to .env.local (never commit it).
# Every value here is public build-time config; secrets live on the gateway.
# NEXT_PUBLIC_* is inlined by `next build`: changing it requires a rebuild/redeploy.
# scripts/check-env.mjs (`predev`/`prebuild`) warns in dev and fails the build when
# NEXT_PUBLIC_GATEWAY_URL is unset.

# Gateway origin. Production goes through Cloudflare: https://api.faazio.com
# (local: http://localhost:8080). The Next.js route handlers call this server-side and proxy
# /api/gateway/*.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# Optional media CDN/asset base. Prod: https://img.faazio.in (R2 custom domain), which makes portal
# image URLs render from the Cloudflare edge. Leave empty for local dev — the portal defaults to the
# gateway's /assets path.
NEXT_PUBLIC_MEDIA_CDN_BASE=

# Public legal pages linked from the /login acceptance row. Each defaults to the landing page
# (https://faazio.com/terms and /privacy) when unset, so the links always resolve.
NEXT_PUBLIC_TERMS_URL=https://faazio.com/terms
NEXT_PUBLIC_PRIVACY_URL=https://faazio.com/privacy

# Portal auth is the only auth mode. The gateway needs PORTAL_JWT_SECRET + PORTAL_PEPPER and
# migrations 0032 + 0033 applied. See docs/RUNBOOKS/PORTAL_AUTH.md.
