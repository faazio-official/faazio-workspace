# Faazio MVP gateway — environment template. Copy to .env and fill locally.
# NEVER commit real secrets (AGENTS.md). In production use Cloud Run secrets.

GATEWAY_ADDR=:8080

# Supabase Postgres (use the pooled connection string; keep sslmode=require in prod)
DATABASE_URL=

# Aiven Valkey (TLS URL in prod, e.g. rediss://default:...@host:port/0)
VALKEY_URL=

# MongoDB Atlas M0
MONGO_URI=
MONGO_DATABASE=faazio

# Supabase JWT secret (Project Settings → API → JWT Secret) for HS256 verification.
SUPABASE_JWT_SECRET=

# Supabase Storage (prescription images): project URL + service_role key. When unset,
# POST /prescriptions/upload-url returns 503 (storage disabled).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
PRESCRIPTION_BUCKET=prescriptions

# Cloudflare R2 (media bytes: products, stores, menus, banners, brands, avatars, Rx, KYC).
# The gateway is the only minter/signer; clients receive short-lived presigned URLs. When
# ACCOUNT_ID/ACCESS_KEY_ID/SECRET_ACCESS_KEY are unset the media context is disabled (503).
# CDN_BASE is the custom domain in front of the public bucket (Cache Rule: Edge TTL 1y, immutable).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=faazio-public
R2_PRIVATE_BUCKET=faazio-private
R2_CDN_BASE=https://img.faazio.in

# Razorpay (seat bookings). When KEY_ID/KEY_SECRET are unset the bookings context runs in mock
# mode (orders simulated, capture/refund no-ops) — safe for local dev and CI. The webhook secret
# verifies the HMAC on POST /webhooks/razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Fixed per-seat booking platform fee in paisa (default 5000 = ₹50). A deploy constant; the
# restaurant can never set its own fee.
BOOKING_FEE_PAISA=5000

# Local dev only — disables JWT verification and uses DEV_USER_ID / X-Dev-User.
AUTH_DISABLED=false
DEV_USER_ID=user-1

# Comma-separated Cloudflare/app origins allowed by CORS.
ALLOWED_ORIGINS=

# OpenTelemetry exporter (optional; no-op when false)
OTEL_ENABLED=false