node_modules/
build/
dist/
/coverage/
.DS_Store
*.log
.env*
# Firebase service-account / FCM private-key artifacts (downloaded; creds live in the
# FCM_SERVICE_ACCOUNT_JSON env var / dashboard secret).
server/gateway/.secrets/
server/gateway/project-*.json
# Apple Push Notifications auth key (APNs .p8). Downloads land in the repo root; the key must
# never enter git — the gateway reads it from APNS_PRIVATE_KEY_PEM instead. Keep the file at
# server/gateway/.secrets/AuthKey_*.p8 (also covered by the .secrets/ rule above).
AuthKey_*.p8
*.p8
*.apk
*.aab

# Perch local tooling
.perch/

# Signing fingerprints: local-only single source of truth.
# NOT committed — these digests must never enter git history again.
docs/RUNBOOKS/SIGNING_FINGERPRINTS.md
# iOS provisioning profiles - local only, never commit
*.mobileprovision
# Python bytecode cache (generated)
__pycache__/
*.pyc
